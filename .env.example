# ─── Blockchain ───────────────────────────────────────────────────────────────
# Your wallet private key (never commit the real .env file!)
PRIVATE_KEY=your_wallet_private_key_here

# Sepolia RPC URL — get a free one from https://infura.io or https://alchemy.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Etherscan API key for contract verification — https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ─── Deployed Contract Addresses (fill after deployment) ──────────────────────
REACT_APP_FACTORY_ADDRESS=
REACT_APP_NETWORK_ID=11155111
